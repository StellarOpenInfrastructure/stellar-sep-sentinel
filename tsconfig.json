{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@stellar-sep-sentinel/core": [
        "packages/core/src/index.ts"
      ]
    },
    "rootDir": "."
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "frontend"
  ]
}
